{
  // 저장/불러오기용 작은 Cloudflare Worker. 뼈대 단계에서는 /health 만 응답합니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insulation-partition-generator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }

  // 주의: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / JWT_SECRET 같은 비밀값은
  // 이 파일이나 코드에 넣지 않는다. `wrangler secret put <NAME>` 또는
  // Cloudflare 대시보드에서 관리한다. (저장/불러오기 이식 단계에서 등록)
}
