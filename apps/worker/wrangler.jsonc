{
  // 단열재 나누기도 생성기 Worker — 프론트엔드(SPA) + 저장/불러오기 API 를 한 Worker 가 서빙.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insulation-partition-generator",
  // smarttech(team-smartcon-tech) Cloudflare 계정. 계정 ID는 시크릿이 아님(SSX도 커밋됨).
  // GitHub 연결 빌드/CLI 가 이 계정으로 확정 배포되도록 명시.
  "account_id": "2b025f536a98444871b3306efbfd6b2a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // DCR 통합로그인 백엔드(회원 로그인 프록시 대상). 이 값은 prod = dcr-app.
  // 로컬/dev 는 apps/worker/.dev.vars 에서 DCR_BASE_URL=https://dcr-app-dev.jogh.workers.dev 로 덮어써 dcr-dev 로 향하게 한다.
  // (서비스 바인딩을 쓰려면 아래 services 주석 해제 — 동일 계정이라 가능. 그 경우 DCR_APP 이 DCR_BASE_URL 보다 우선.)
  "vars": {
    "DCR_BASE_URL": "https://dcr-app.jogh.workers.dev"
  },
  // 동일 계정(Smarttech) dcr-app 으로의 서버-투-서버 로그인 프록시.
  // 동일 계정 workers.dev 간 공개 URL fetch 는 응답을 제대로 못 받는 경우가 있어 서비스 바인딩을 사용.
  // (로컬 dev 는 바인딩이 없으므로 DCR_BASE_URL 폴백 사용 — auth.ts 가 DCR_APP 우선.)
  "services": [{ "binding": "DCR_APP", "service": "dcr-app" }],

  // 정적 자산: apps/web 의 Vite 빌드 결과(dist)를 서빙한다.
  //  - run_worker_first 에 해당하는 경로(/api/*, /health)만 Worker 스크립트가 먼저 처리
  //  - 그 외 경로는 자산에서 서빙하고, 매칭 없으면 SPA fallback 으로 index.html 반환
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }

  // 주의: 비밀값(SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / IPG_JWT_SECRET)은
  // 이 파일이나 코드에 넣지 않는다. `wrangler secret put <NAME>` 또는 Cloudflare 대시보드에서 관리한다.
  //  - IPG_JWT_SECRET: 신규 앱 자체 세션 토큰용 시크릿(DCR 것과 별개, 강한 랜덤값). 필수.
  //  - (선택) RATE_LIMIT: 로그인 rate-limit용 KV 네임스페이스. 없으면 제한 생략.
  //      kv_namespaces 로 바인딩 후 사용: [{ "binding": "RATE_LIMIT", "id": "<kv-id>" }]
}
