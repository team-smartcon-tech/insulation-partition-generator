{
  // 단열재 나누기도 생성기 Worker — 프론트엔드(SPA) + 저장/불러오기 API 를 한 Worker 가 서빙.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insulation-partition-generator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 정적 자산: apps/web 의 Vite 빌드 결과(dist)를 서빙한다.
  //  - run_worker_first 에 해당하는 경로(/api/*, /health)만 Worker 스크립트가 먼저 처리
  //  - 그 외 경로는 자산에서 서빙하고, 매칭 없으면 SPA fallback 으로 index.html 반환
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }

  // 주의: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 같은 비밀값은
  // 이 파일이나 코드에 넣지 않는다. `wrangler secret put <NAME>` 또는
  // Cloudflare 대시보드에서 관리한다.
}
