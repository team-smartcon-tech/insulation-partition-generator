.claude/settings.local.json

# Dependencies / build output
node_modules/
dist/
build/
.vite/
.wrangler/
.turbo/
coverage/

# Local environment files. Keep examples tracked.
.env
.env.*
!.env.example
!.env.*.example
# Cloudflare Worker 로컬 시크릿 (wrangler dev) — 절대 커밋 금지
.dev.vars
.dev.vars.*
!.dev.vars.example

# OS / editor
.DS_Store
Thumbs.db
*.log
# MS Office 임시 잠금파일 (문서 열어두면 자동 생성 → 소스컨트롤에 뜨지 않게)
~$*

# Python 엔진
engine/**/__pycache__/
engine/.pytest_cache/
engine/*.egg-info/

# 양식 미리보기 도구가 만드는 임시 결과물(scripts/form-preview.mjs)
tmp-preview.html

# 엑셀이 파일을 열어둘 때 만드는 잠금 파일
~$*

# Supabase CLI 가 연결한 프로젝트 정보를 적어 두는 곳(로컬 전용)
supabase/.temp/
