{
  "$schema": "https://opencode.ai/config.json",
  "username": "woomi",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "lsp": true,
  "instructions": [
    "AGENTS.md",
    ".agents/ARCHITECTURE.md",
    ".agents/STACK.md",
    ".agents/WORKFLOW.md",
    ".agents/TOOLING.md"
  ],
  "skills": {
    "paths": [
      ".codex/skills"
    ]
  },
  "references": {
    "agents": {
      "path": ".agents",
      "description": "Woomi 프로젝트 에이전트 규칙 및 가이드 문서"
    },
    "code": {
      "path": ".agents/code",
      "description": "코드 스타일, API, 에러 핸들링, 프로젝트 구조 가이드"
    },
    "data": {
      "path": ".agents/data",
      "description": "DB 스키마, 마이그레이션, API 계약 문서"
    },
    "ui": {
      "path": ".agents/ui",
      "description": "디자인, UX 규칙, 컴포넌트 가이드"
    },
    "githooks": {
      "path": ".githooks",
      "description": "Git 훅 safeguard (pre-commit, pre-push)"
    },
    "scripts": {
      "path": "scripts",
      "description": "agent-guard.cjs 훈련 스크립트"
    },
    "wiki": {
      "path": "wiki",
      "description": "팀 지식 위키"
    },
    "wiki-rules": {
      "path": "wiki/rules",
      "description": "위키 규칙 정리본"
    },
    "wiki-systems": {
      "path": "wiki/systems",
      "description": "위키 화면·경로 정리"
    },
    "wiki-patterns": {
      "path": "wiki/patterns",
      "description": "위키 반복 실패 정리"
    },
    "wiki-sources": {
      "path": "wiki/sources",
      "description": "위키 원본 자료"
    },
    "claude-commands": {
      "path": ".claude/commands",
      "description": "Claude Code 명령 (참고용 — opencode 명령 링크는 두지 않았다)"
    },
    "codex-prompts": {
      "path": ".codex/prompts",
      "description": "Codex 프롬프트 (참고용)"
    }
  },
  "agent": {
    "general": {
      "description": "Woomi 프로젝트의 기본 에이전트. AGENTS.md와 .agents/ 문서를 따라 작업한다.",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch --show-current": "allow",
          "git branch --list*": "allow",
          "git remote -v": "allow",
          "git rev-parse*": "allow",
          "git switch -c*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "git config core.hooksPath*": "ask",
          "git config core.hooksPath .githooks": "allow",
          "pnpm -r typecheck": "allow",
          "pnpm --filter web build": "allow",
          "node --experimental-strip-types --no-warnings --test tests/*": "allow",
          "node scripts/agent-guard.cjs*": "allow",
          "git commit*--no-verify*": "deny",
          "git commit* -n*": "deny",
          "git push*--no-verify*": "deny",
          "git push*--force*": "deny",
          "git push* -f*": "deny",
          "git reset*--hard*": "deny",
          "supabase db reset*": "deny"
        }
      }
    },
    "build": {
      "description": "빌드 및 배포 작업 전담 에이전트",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "pnpm -r typecheck": "allow",
          "pnpm --filter web build": "allow",
          "node --experimental-strip-types --no-warnings --test tests/*": "allow",
          "node scripts/agent-guard.cjs*": "allow",
          "pnpm --filter worker run deploy:dry": "allow",
          "git commit*--no-verify*": "deny",
          "git commit* -n*": "deny",
          "git push*--no-verify*": "deny",
          "git push*--force*": "deny",
          "git push* -f*": "deny",
          "git reset*--hard*": "deny",
          "supabase db reset*": "deny"
        }
      }
    },
    "plan": {
      "description": "작업 계획 및 리뷰 전담 에이전트",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    }
  },
  "default_agent": "general",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --show-current": "allow",
      "git branch --list*": "allow",
      "git remote -v": "allow",
      "git rev-parse*": "allow",
      "git switch -c*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git config core.hooksPath*": "ask",
      "git config core.hooksPath .githooks": "allow",
      "pnpm -r typecheck": "allow",
      "pnpm --filter web build": "allow",
      "node --experimental-strip-types --no-warnings --test tests/*": "allow",
      "node scripts/agent-guard.cjs*": "allow",
      "git commit*--no-verify*": "deny",
      "git commit* -n*": "deny",
      "git push*--no-verify*": "deny",
      "git push*--force*": "deny",
      "git push* -f*": "deny",
      "git reset*--hard*": "deny",
      "supabase db reset*": "deny"
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
