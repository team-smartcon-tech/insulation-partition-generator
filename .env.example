# ── 환경 변수 "이름"만 참고용 (실제 값을 여기 적지 말 것) ───────────────
# 실제 값은 Cloudflare Worker Secrets(`wrangler secret put ...`) 또는
# Cloudflare 대시보드에서 관리합니다. .env 파일은 커밋 금지(.gitignore 처리됨).
# 프론트엔드(apps/web) 코드에서는 아래 서버 비밀값을 절대 참조하지 않습니다.

# 새 Supabase 프로젝트 값 (apps/worker 전용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 저장/불러오기 인증용 (다음 단계에서 방식 확정)
JWT_SECRET=
